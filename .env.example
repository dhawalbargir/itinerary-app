# Postgres (added automatically when you connect Neon in Vercel → Storage)
DATABASE_URL=

# Vercel Blob (added automatically when you create a Blob store in Vercel → Storage)
BLOB_READ_WRITE_TOKEN=

# Sign-in: the password you will type on the login page, and a long random secret
# Generate a secret with:  openssl rand -base64 32
APP_PASSWORD=
AUTH_SECRET=

# Document reading (OpenAI: https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Flight history (AeroDataBox via RapidAPI: https://rapidapi.com/aedbx-aedbx/api/aerodatabox)
AERODATABOX_API_KEY=
AERODATABOX_HOST=aerodatabox.p.rapidapi.com
FLIGHT_CALLS_PER_DAY=200

# Fallback time zone for items whose place can't be resolved
DEFAULT_TZ=Asia/Kolkata
